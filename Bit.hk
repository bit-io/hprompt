[package]
-> name        => hprompt
-> version     => 0.1.0
-> description => Line-editing & history for H#, in the spirit of Rust's rustyline.
-> authors     => ["Bit Developers"]
-> license     => Apache-2.0
-> lang        => h#

[edition]
-> edition => 2026

[layout]
-> src => src

[build]
-> link => static

[lib]
-> output => hlib

[pack]
-> contents    => [hlib, sources, docs]
-> compression => zstd

[dependencies]
